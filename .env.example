# Astra v2: server-only configuration. Never put real credentials in GitHub.
# Both required for login. Password >=12 characters; JWT secret >=32 characters.
ASTRA_ADMIN_PASSWORD=
ASTRA_JWT_SECRET=
# HTTPS/Render=true. Only local HTTP development may use false.
COOKIE_SECURE=true
# Optional canonical HTTPS origin; Render automatically supplies RENDER_EXTERNAL_URL.
# Leave empty locally. For a custom domain: https://your-domain.example (no path).
ASTRA_PUBLIC_ORIGIN=
ASTRA_DATABASE_PATH=data/astra.sqlite3
ASTRA_HOST=127.0.0.1
PORT=8000
LEGACY_PORT=10000
LEGACY_API_URL=http://127.0.0.1:10000

OPENAI_API_KEY=
OPENAI_COMMANDER_MODEL=gpt-6-astra
# Optional lower-cost news classifier; blank disables its API calls.
OPENAI_AGENT_MODEL=
OPENAI_MAX_CALLS_PER_DAY=20
OPENAI_MAX_CALLS_PER_RUN=3
ALPHA_VANTAGE_API_KEY=
# Set your real organization/contact to enable read-only SEC EDGAR retrieval.
SEC_USER_AGENT=

BROKER_MODE=shadow
AUTO_TRADE=false
LIVE_TRADING=false
PAPER_TRADING=false
SHADOW_TRADING=true
MANUAL_APPROVAL=true
SHADOW_INITIAL_CASH_USD=100000
ASTRA_BACKGROUND_JOBS=true
ASTRA_REFRESH_SECONDS=900
ASTRA_UNIVERSE=SPY,QQQ,IWM,SOXX,NVDA,MU,SNDK,VRT,ANET,JMIA,RKLB,POET,CIFR,IREN,IONQ,OKLO

# Fractions, not percent points: 0.01 = 1%. Server-owned limits only.
MAX_POSITIONS=5
MAX_POSITION_PCT=0.20
MAX_RISK_PER_TRADE=0.01
MAX_DAILY_LOSS=0.03
MAX_DRAWDOWN=0.10
MAX_CONSECUTIVE_LOSSES=5
MAX_SPREAD=0.005
MINIMUM_LIQUIDITY=1000000
MINIMUM_AVERAGE_VOLUME=100000
MAXIMUM_SLIPPAGE=0.005
MAX_QUOTE_AGE_SECONDS=120
MAX_PRICE_DISCREPANCY=0.005
ORDER_COOLDOWN_SECONDS=900
MINIMUM_RISK_REWARD=1.8

# Existing v14 provider configuration remains supported below.
# Optional: preferred official US quote provider (free personal-use plan available)
FINNHUB_API_KEY=

# Optional: server-side AI features
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-6

# Required whenever FINNHUB_API_KEY or ANTHROPIC_API_KEY is set.
# Enter the same value in the app settings. Use a long random value.
API_TOKEN=

# Optional comma-separated cross-origin frontends. Same-origin works without this.
ALLOWED_ORIGINS=

# Advanced tuning
QUOTE_CACHE_TTL_MS=45000
QUOTE_STALE_TTL_MS=86400000
QUOTE_NEGATIVE_TTL_MS=30000
MARKET_DATA_DEADLINE_MS=14000
QUOTE_RATE_LIMIT_PER_MINUTE=12
THEME_RATE_LIMIT_PER_MINUTE=18
THEME_CACHE_TTL_MS=900000
THEME_PARTIAL_CACHE_TTL_MS=120000
THEME_STALE_TTL_MS=86400000
THEME_DATA_DEADLINE_MS=12000
THEME_UPSTREAM_TIMEOUT_MS=7000
INTELLIGENCE_RATE_LIMIT_PER_MINUTE=6
INTELLIGENCE_CACHE_TTL_MS=900000
INTELLIGENCE_PARTIAL_TTL_MS=120000
INTELLIGENCE_STALE_TTL_MS=86400000
INTELLIGENCE_DATA_DEADLINE_MS=20000
MARKET_REGIME_RATE_LIMIT_PER_MINUTE=12
MARKET_REGIME_CACHE_TTL_MS=900000
MARKET_REGIME_SPY_ADJUSTED_TTL_MS=900000
MARKET_REGIME_PARTIAL_CACHE_TTL_MS=120000
MARKET_REGIME_STALE_TTL_MS=86400000
MARKET_REGIME_DATA_DEADLINE_MS=12000
TECHNICAL_SIGNAL_RATE_LIMIT_PER_MINUTE=6
TECHNICAL_BACKTEST_RATE_LIMIT_PER_MINUTE=2
TECHNICAL_SIGNAL_ROUTE_TIMEOUT_MS=35000
TECHNICAL_BACKTEST_ROUTE_TIMEOUT_MS=75000
TECHNICAL_SIGNAL_MAX_CONCURRENCY=3
TECHNICAL_BACKTEST_MAX_CONCURRENCY=1
TECHNICAL_CACHE_TTL_MS=900000
TECHNICAL_STALE_TTL_MS=86400000
TECHNICAL_DATA_DEADLINE_MS=25000
TECHNICAL_UPSTREAM_TIMEOUT_MS=8000
TECHNICAL_YAHOO_BATCH_SIZE=20
TECHNICAL_CHART_CONCURRENCY=4
TECHNICAL_CACHE_MAX_ENTRIES=120
TECHNICAL_FINNHUB_CACHE_TTL_MS=21600000
TECHNICAL_FINNHUB_MAX_SYMBOLS=8
DIAGNOSE_RATE_LIMIT_PER_MINUTE=6
AI_RATE_LIMIT_PER_MINUTE=3
API_GENERAL_RATE_LIMIT_PER_MINUTE=60
FINNHUB_CALLS_PER_MINUTE=55
NASDAQ_MAX_SYMBOLS=5
YAHOO_BATCH_WINDOW_MS=20
MARKET_DATA_MAX_IN_FLIGHT=500
PROVIDER_DIVERGENCE_PCT=1.5
